# Конфигурация приложения на VDS: скопируйте в erp.env рядом с docker-compose.yml и заполните.
# Файл с секретами — права 600, в git не коммитится.

PUBLIC_URL=https://erp.example.ru
TRUST_PROXY=1
COOKIE_SECURE=1

# Первый администратор: создаётся при старте, если такого логина ещё нет.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Бэкапы базы внутри тома /data/backups
BACKUP_KEEP_DAYS=14

# Диск Битрикс24: файлы хранятся в папке «ERP» общего диска.
# Вебхук — секрет: только здесь, не в git и не в переписке.
BITRIX_MODE=live
BITRIX_WEBHOOK_URL=
# Необязательно: ID папки «ERP» (иначе ищется по имени на общем диске)
BITRIX_ROOT_FOLDER_ID=
# Сверка удалённых на Диске файлов, минуты
BITRIX_SYNC_MINUTES=10
