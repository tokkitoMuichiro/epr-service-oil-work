{
  "name": "erp-ammir",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "preview": "npm run preview --workspace=client",
    "typecheck": "npm run typecheck --workspace=client && npm run typecheck --workspace=server && tsc -p e2e",
    "test": "tsx --test \"shared/src/**/*.test.ts\" \"server/src/**/*.test.ts\"",
    "test:e2e": "npm run build --workspace=client && playwright test",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
